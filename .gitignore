# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo

# Local config
.env
.env.*
!.env.example

# Frozen Python prototype kept on disk for local reference only. The
# repository removed it in 30b2c47 (2026-11-04); the TypeScript package
# (packages/harness) is the sole implementation (see AGENTS.md). These paths
# are never committed or published. The ignore rules came back because
# checkouts that restored the prototype from history still carry the tree.
# Keep this section in sync with the paths listed in AGENTS.md.
/.venv/
/venv/
/python/
/tools/
/serve.sh
/plugins/notes.py
/docs/develop/
/docs/product/
__pycache__/
*.py[cod]
*.egg-info/
/pip-*/

# Local runs / verification artifacts.
# Anchored to the repository root so local-only patterns cannot shadow tracked
# files nested deeper in the tree.
/sessions/
/.e2e-tmp/
/.build-tmp/
/.tmp/
/.zcode/
/research/
/tmp*/
/tb-*/
/--version/
/version/
/wheelhouse/
/mcp-demo-config.json
*.request.json
*.log

# Personal planning scratch and local session handoff, not project docs.
# Root-anchored on purpose: docs/history/handoff.md is a tracked frozen record
# and must not be shadowed by these rules on case-insensitive filesystems.
/todo.md
/TODO.md
/HANDOFF.md

# Real-model E2E evidence (packages/harness)
packages/harness/e2e/runs/
# Package-local session output: running the package CLI with a relative
# --sessions-dir (for example from packages/harness) leaves session files here.
# The root-anchored `/sessions/` rule above deliberately does not cover it.
/packages/harness/sessions/

# Local pack artifacts (npm pack for install testing)
packages/harness/*.tgz
# Built web app copied into the package for the npm tarball (scripts/sync-web.mjs)
packages/harness/web/
