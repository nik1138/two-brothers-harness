# Two Brothers — sample environment (.env)
# Set the variables in your terminal, or copy this file to .env and fill it in.
# Precedence: CLI flags > environment variables > defaults.

# --- provider ---
# openai = OpenAI-compatible endpoint; mock = offline, deterministic
TWO_BROTHERS_PROVIDER=openai

# OpenAI-compatible base URL. Examples:
#   DeepSeek        : https://api.deepseek.com/v1
#   OpenAI          : https://api.openai.com/v1
#   OpenRouter      : https://openrouter.ai/api/v1
#   vLLM / llama.cpp: http://127.0.0.1:8000/v1
#   Ollama          : http://127.0.0.1:11434/v1
#   OpenCode Zen    : http://127.0.0.1:8787/v1
TWO_BROTHERS_BASE_URL=http://127.0.0.1:8787/v1

# API key. May be empty for a local server.
TWO_BROTHERS_API_KEY=

# --- models ---
# For a first offline run nothing needs to be set — use the mock provider.
TWO_BROTHERS_SENIOR_MODEL=deepseek-v4.1-flash-free
TWO_BROTHERS_JUNIOR_MODEL=glm-5.3-flash-free

# --- options ---
TWO_BROTHERS_MAX_ROUNDS=3
TWO_BROTHERS_TEMPERATURE=0.4
TWO_BROTHERS_TIMEOUT=120
# consult | work | auto
TWO_BROTHERS_MODE=consult
TWO_BROTHERS_VERBOSE=false
TWO_BROTHERS_JSON=false

# JSONL session file (persist/resume: --session-file / --resume)
TWO_BROTHERS_SESSION_FILE=
TWO_BROTHERS_RESUME=false

# JSON file with MCP server definitions for the junior (delegation mode;
# in work mode the junior receives those tools). Example:
#   {"mcpServers": {"filesystem": {"command": "npx",
#     "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]}}}
#TWO_BROTHERS_MCP_CONFIG=
